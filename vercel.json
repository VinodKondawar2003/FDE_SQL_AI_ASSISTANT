{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "includeFiles": "{data/sample.db,frontend/dist/**}",
      "excludeFiles": "{.env,.env.*,.venv/**,.runtime/**,docs/**,specs/**,evals/**,backend/tests/**,frontend/node_modules/**,frontend/src/**,frontend/tests/**,frontend/test-results/**,frontend/playwright-report/**,**/__pycache__/**}"
    }
  }
}
